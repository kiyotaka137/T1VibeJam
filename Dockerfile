# Шаг 1: Используем официальный образ Node.js (легкая версия Alpine)
FROM node:18-alpine

# Шаг 2: Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Шаг 3: Копируем файлы package.json и package-lock.json
COPY package*.json ./

# Шаг 4: Устанавливаем зависимости
RUN npm install

# Шаг 5: Копируем весь остальной код проекта
COPY . .

# Шаг 6: Открываем порт 5173 (стандартный для Vite)
EXPOSE 5173

# Шаг 7: Запускаем приложение в режиме разработки с флагом --host
# Флаг --host обязателен, чтобы приложение было доступно извне контейнера
CMD ["npm", "run", "dev", "--", "--host"]